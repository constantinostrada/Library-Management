# ─────────────────────────────────────────────────────────────────────────────
# Library Management — Environment Variables
# Copy this file to .env.local for local development.
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:password@localhost:5432/library_management?schema=public"

# ── Next.js ───────────────────────────────────────────────────────────────────
# Base URL of the application (used for absolute URL generation)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Application ───────────────────────────────────────────────────────────────
# Default number of days a book can be borrowed before it is overdue
LOAN_DURATION_DAYS=14

# Maximum number of books a member can borrow simultaneously
MAX_BOOKS_PER_MEMBER=5
